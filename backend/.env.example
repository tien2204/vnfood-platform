DATABASE_URL=postgresql+asyncpg://vnfood:vnfood123@localhost:5432/vnfood_db

# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_run_the_command_above_to_generate_a_64_char_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
REFRESH_TOKEN_EXPIRE_DAYS=7
OPENAI_API_KEY=sk-...
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
MODEL_WEIGHTS_DIR=../model_weights

# ── Email / Newsletter (Gmail SMTP) ───────────────────────────────
# Tạo App Password: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME=VNFood
SMTP_FROM_EMAIL=
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# Rate-limit storage — empty = in-memory (dev). Multi-instance prod: Upstash Redis URI
# RATE_LIMIT_STORAGE_URI=rediss://default:<password>@<host>.upstash.io:6379
RATE_LIMIT_STORAGE_URI=
