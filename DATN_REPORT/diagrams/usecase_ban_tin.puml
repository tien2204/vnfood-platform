@startuml usecase_ban_tin
' Biểu đồ use case Bản tin công thức (đăng ký nhận công thức mới qua email)
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
left to right direction

actor "Người dùng" as User
actor "Quản trị viên" as Admin

rectangle "Bản tin công thức" {
  usecase "Đăng ký nhận bản tin" as UC_Subscribe
  usecase "Hủy nhận bản tin" as UC_Unsubscribe
  usecase "Gửi bản tin công thức" as UC_Send
  usecase "Dựng nội dung email từ\ncông thức mới" as UC_Compose
}

User --> UC_Subscribe
User --> UC_Unsubscribe
Admin --> UC_Send

UC_Send ..> UC_Compose : <<include>>
@enduml
